@@ -110,3 +110,40 @@
 service.sync = withKeepalive(service.sync);
 service.syncAll = withKeepalive(service.syncAll);
 serveRuntime(runtime, "background", service);
+
+// Orma local web-app bridge. Only explicit loopback origins; never export cookies/raw pages.
+let ormaRun = {running:false,reports:[],selected:[]};
+chrome.runtime.onMessageExternal.addListener((message,sender,respond)=>{
+    if(!/^http:\/\/(localhost|127\.0\.0\.1):(5173|8000)\/?$/.test(sender.origin || new URL(sender.url).origin)) {
+        respond({error:"Only the local Orma app may connect."}); return false;
+    }
+    const allowed={linkedin:100,instagram:50,youtube:50,twitter:50};
+    (async()=>{
+        if(message.action==="ping") return {ok:true,name:"Linkosh",version:chrome.runtime.getManifest().version};
+        if(message.action==="status") return {...ormaRun,progress:await service.syncStatus({})};
+        if(message.action==="stop") {await service.syncStop({});return {ok:true};}
+        if(message.action==="result") {
+            const {data}=await service.exportDb({});
+            return {items:data.items.filter(i=>ormaRun.selected.includes(i.provider)),reports:ormaRun.reports};
+        }
+        if(message.action==="start") {
+            if(ormaRun.running) throw Error("A capture is already running.");
+            const selected=[...new Set(message.platforms || [])].map(p=>p==="x"?"twitter":p).filter(p=>p in allowed);
+            if(!selected.length) throw Error("Choose a platform.");
+            ormaRun={running:true,reports:[],selected};
+            void (async()=>{
+                const previous=await prefs.get("captureRaw");
+                try {
+                    await prefs.set("captureRaw",false);
+                    for(const provider of selected){
+                        try {ormaRun.reports.push(await service.sync({provider,full:true,maxItems:allowed[provider]}));}
+                        catch(error){ormaRun.reports.push({providerId:provider,status:"failed",error:String(error.message||error)});}
+                    }
+                } finally {await prefs.set("captureRaw",previous ?? false);ormaRun.running=false;}
+            })();
+            return {started:true};
+        }
+        throw Error("Unsupported Orma action");
+    })().then(respond,error=>respond({error:String(error.message||error)}));
+    return true;
+});
