{
  "manifest_version": 3,
  "name": "Orma LinkedIn Capture",
  "version": "0.1.0",
  "description": "Ordered saved-post capture and media inspection. No database or embeddings.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_title": "Open Orma capture"
  },
  "background": {
    "service_worker": "background.js"
  }
}